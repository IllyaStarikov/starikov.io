{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": 1,
  "defaults": {
    "light": "tokyonight_day",
    "dark": "tokyonight_storm"
  },
  "families": {
    "tokyonight": {
      "name": "Tokyo Night",
      "url": "https://github.com/folke/tokyonight.nvim",
      "neovim_plugin": "folke/tokyonight.nvim",
      "variants": {
        "day": {
          "display_name": "Day",
          "mode": "light",
          "neovim_colorscheme": "tokyonight-day",
          "neovim_style": "day",
          "bat_theme": "tokyonight_day"
        },
        "night": {
          "display_name": "Night",
          "mode": "dark",
          "neovim_colorscheme": "tokyonight-night",
          "neovim_style": "night",
          "bat_theme": "tokyonight_night"
        },
        "moon": {
          "display_name": "Moon",
          "mode": "dark",
          "neovim_colorscheme": "tokyonight-moon",
          "neovim_style": "moon",
          "bat_theme": "tokyonight_moon"
        },
        "storm": {
          "display_name": "Storm",
          "mode": "dark",
          "neovim_colorscheme": "tokyonight-storm",
          "neovim_style": "storm",
          "bat_theme": "tokyonight_storm"
        }
      }
    },
    "github": {
      "name": "GitHub",
      "url": "https://github.com/projekt0n/github-nvim-theme",
      "neovim_plugin": "projekt0n/github-nvim-theme",
      "variants": {
        "light": {
          "display_name": "Light",
          "mode": "light",
          "neovim_colorscheme": "github_light",
          "bat_theme": "GitHub"
        },
        "dark": {
          "display_name": "Dark",
          "mode": "dark",
          "neovim_colorscheme": "github_dark",
          "bat_theme": "GitHub"
        },
        "dark_dimmed": {
          "display_name": "Dark Dimmed",
          "mode": "dark",
          "neovim_colorscheme": "github_dark_dimmed",
          "bat_theme": "GitHub"
        },
        "dark_high_contrast": {
          "display_name": "Dark High Contrast",
          "mode": "dark",
          "neovim_colorscheme": "github_dark_high_contrast",
          "bat_theme": "GitHub"
        },
        "light_high_contrast": {
          "display_name": "Light High Contrast",
          "mode": "light",
          "neovim_colorscheme": "github_light_high_contrast",
          "bat_theme": "GitHub"
        },
        "dark_default": {
          "display_name": "Dark Default",
          "mode": "dark",
          "neovim_colorscheme": "github_dark_default",
          "bat_theme": "GitHub"
        },
        "light_default": {
          "display_name": "Light Default",
          "mode": "light",
          "neovim_colorscheme": "github_light_default",
          "bat_theme": "GitHub"
        },
        "dark_colorblind": {
          "display_name": "Dark Colorblind",
          "mode": "dark",
          "neovim_colorscheme": "github_dark_colorblind",
          "bat_theme": "GitHub"
        },
        "light_colorblind": {
          "display_name": "Light Colorblind",
          "mode": "light",
          "neovim_colorscheme": "github_light_colorblind",
          "bat_theme": "GitHub"
        },
        "dark_tritanopia": {
          "display_name": "Dark Tritanopia",
          "mode": "dark",
          "neovim_colorscheme": "github_dark_tritanopia",
          "bat_theme": "GitHub"
        },
        "light_tritanopia": {
          "display_name": "Light Tritanopia",
          "mode": "light",
          "neovim_colorscheme": "github_light_tritanopia",
          "bat_theme": "GitHub"
        }
      }
    }
  },
  "aliases": {
    "light": "defaults.light",
    "dark": "defaults.dark",
    "day": "tokyonight_day",
    "night": "tokyonight_night",
    "moon": "tokyonight_moon",
    "storm": "tokyonight_storm",
    "latte": "catppuccin_latte",
    "frappe": "catppuccin_frappe",
    "macchiato": "catppuccin_macchiato",
    "mocha": "catppuccin_mocha",
    "mirage": "ayu_mirage",
    "palenight": "material_palenight",
    "oceanic": "material_oceanic"
  }
}
