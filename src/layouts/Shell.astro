---
/*
 * Shell -- the persistent chassis every page lives in.
 *
 * Grid: 240px sidebar / fluid content / 224px right rail. The rail appears at
 * ≥1280px, the sidebar collapses to a mobile top bar + full-screen nav <dialog>
 * below 1024px. The sidebar is wrapped in transition:persist so it survives
 * ClientRouter navigations untouched (shell.ts re-resolves the active item and
 * slides the accent bar on each swap).
 *
 * Pages import Shell only; Shell wraps Base (which owns <head>, CSP, theme boot,
 * ClientRouter). Pages supply their own <h1> in the default slot.
 */
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RightRail from '../components/RightRail.astro';
import Palette from '../components/Palette.astro';
import { sortProjects } from '../lib/model';
import type { ToolRef, ProjectRef } from '../lib/nav';

interface Crumb {
  href: string;
  label: string;
}
interface TocItem {
  id: string;
  label: string;
}
interface Fact {
  label: string;
  value: string;
  href?: string;
  external?: boolean;
  badge?: boolean;
}
interface Connection {
  href: string;
  label: string;
  external?: boolean;
}
interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
  toc?: TocItem[];
  facts?: Fact[];
  connections?: Connection[];
  pageType?: string;
  /* Override the sidebar Tools group; defaults to the whole tools collection
     so every page's sidebar lists every tool without per-page wiring. */
  tools?: ToolRef[];
  /* Same for the Projects group; defaults to the projects collection. */
  projects?: ProjectRef[];
}

// The Tools group is populated centrally from the collection (the seam Task 7
// left as an optional `tools` prop). Loading here -- not in each page -- is what
// makes "a new tool in the bin repo appears in the sidebar everywhere" hold on
// every route, including the persisted sidebar after a hard refresh.
const toolRefs: ToolRef[] = (await getCollection('tools'))
  .map((t) => ({ slug: t.id, title: t.data.name, updated: t.data.updated }))
  .sort((a, b) => (b.updated ?? '').localeCompare(a.updated ?? ''));

// The Projects group, same seam: the `projects` collection, featured first (by
// `order`), drafts excluded. A new curated project overlay lands in the sidebar
// on every route with no edit here.
const projectRefs: ProjectRef[] = sortProjects(
  (await getCollection('projects')).filter((p) => !p.data.draft),
).map((p) => ({ slug: p.id, label: p.data.title }));

const {
  title,
  description,
  crumbs,
  toc = [],
  facts = [],
  connections = [],
  pageType,
  tools = toolRefs,
  projects = projectRefs,
} = Astro.props;

const pathname = Astro.url.pathname;
const hasRail = toc.length > 0 || facts.length > 0 || connections.length >= 2;

// Pagefind filter (Task 16): every page that renders Shell carries its own
// `pageType` string ('home', 'tool', 'project', 'tools', 'academia', ...) for
// CSS/topbar hooks -- narrower than the three-value facet search should filter
// on. Collapse it down to the SiteItemType-shaped bucket the ⌘K palette will
// facet by (Task 17): tool pages and project pages keep their identity,
// everything else (including index pages and 404) is just 'page'. Essays are
// never Shell-rendered (they link out to starikov.co), so 'essay' never
// appears here -- consistent with the brief's "essays are not in the Pagefind
// index" resolution.
const pagefindType = pageType === 'tool' ? 'tool' : pageType === 'project' ? 'project' : 'page';

// The 404 page renders through Shell like everything else but has no content
// worth surfacing in search ("404 -- not found" would just be search noise).
// Pagefind's rule: once ANY page on the site opts into data-pagefind-body,
// every page that does NOT carry that attribute is skipped entirely (not
// partially indexed) -- so omitting it here, rather than pairing it with
// data-pagefind-ignore, is what actually keeps this page out of the index.
const isErrorPage = pageType === '404';
---

<Base title={title} description={description}>
  <!-- Mobile-only top bar. Hidden ≥1024px. -->
  <header class="topbar" data-page-type={pageType}>
    <a class="topbar__wordmark" href="/" aria-label="starikov.io home">
      <span>~/starikov</span><span class="topbar__cursor" aria-hidden="true">▊</span>
    </a>
    <div class="topbar__actions">
      <button type="button" class="topbar__btn" data-open-palette aria-label="Search">
        <span aria-hidden="true">⌕</span>
      </button>
      <button type="button" class="topbar__btn" data-mode-toggle aria-label="Toggle light or dark mode">
        <span class="topbar__swatch" aria-hidden="true"></span>
      </button>
      <button
        type="button"
        class="topbar__btn topbar__menu"
        data-nav-open
        aria-label="Open navigation"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </header>

  <div class="shell" data-rail={hasRail ? 'true' : 'false'}>
    <aside class="sidebar" transition:persist="sidebar" aria-label="Sidebar">
      <Sidebar pathname={pathname} tools={tools} projects={projects} variant="desktop" />
    </aside>

    <div class="content-col">
      {crumbs && crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
      <main
        id="main"
        tabindex="-1"
        class:list={{ 'main--home': pageType === 'home' }}
        data-pagefind-body={isErrorPage ? undefined : true}
        data-pagefind-filter={`type:${pagefindType}`}
        data-pagefind-meta={`title:${title}`}
      >
        <slot />
      </main>
    </div>

    {
      hasRail && (
        <div class="rail-col">
          <RightRail toc={toc} facts={facts} connections={connections} />
        </div>
      )
    }
  </div>

  <!-- Full-screen mobile navigation. Native <dialog> gives the focus trap,
       Esc-to-close, and inert background for free. -->
  <dialog class="nav-sheet" data-nav-sheet aria-label="Site navigation">
    <div class="nav-sheet__head">
      <a class="topbar__wordmark" href="/" aria-label="starikov.io home">
        <span>~/starikov</span>
      </a>
      <button type="button" class="topbar__btn" data-nav-close aria-label="Close navigation">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <button type="button" class="nav-sheet__search" data-open-palette>
      <span aria-hidden="true">⌕</span>
      <span>Search…</span>
    </button>
    <Sidebar pathname={pathname} tools={tools} projects={projects} variant="sheet" />
  </dialog>

  <!-- ⌘K command palette: one instance per route (Shell renders on every page).
       Its module + index are lazy; the always-loaded bootstrap lives inside. -->
  <Palette />
</Base>

<script>
  import '../scripts/shell.ts';
</script>

<style>
  /* ---------------------------------------------------------------------
   * Grid
   * ------------------------------------------------------------------- */
  .shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100vh;
  }

  .sidebar {
    display: none;
  }

  .rail-col {
    display: none;
  }

  .content-col {
    min-width: 0;
    padding: var(--s-5) var(--s-4) var(--s-9);
  }

  main {
    max-width: 720px;
    margin-top: var(--s-4);
  }

  /* The skip link moves focus here (tabindex="-1"); it's a scroll/AT target, not
     an interactive control, so it must not paint a focus ring around all content. */
  main:focus {
    outline: none;
  }

  /* Home is the one page that breaks the 720px document column (design §4:
     full-bleed only for the home system card) -- the hero lays a statement
     beside the system card, so it needs the fluid content width. */
  main.main--home {
    max-width: none;
    margin-top: 0;
  }

  /* Sidebar appears at ≥1024px. */
  @media (min-width: 1024px) {
    .shell {
      grid-template-columns: 240px minmax(0, 1fr);
    }

    .sidebar {
      display: block;
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      overflow-y: auto;
      border-right: 1px solid var(--border);
    }

    .content-col {
      padding: var(--s-7) var(--s-7) var(--s-9);
    }
  }

  /* Right rail appears at ≥1280px (only when the page provides rail content). */
  @media (min-width: 1280px) {
    .shell[data-rail='true'] {
      grid-template-columns: 240px minmax(0, 1fr) 224px;
    }

    .rail-col {
      display: block;
      border-left: 1px solid var(--border);
    }
  }

  /* ---------------------------------------------------------------------
   * Mobile top bar (<1024px)
   * ------------------------------------------------------------------- */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    position: sticky;
    top: 0;
    z-index: 20;
    padding: var(--s-3) var(--s-4);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 1024px) {
    .topbar {
      display: none;
    }
  }

  .topbar__wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--fs-16);
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }

  .topbar__cursor {
    display: inline-block;
    margin-left: 1px;
    color: var(--accent);
    animation: topbar-cursor-blink 1s steps(1, end) 2 forwards;
  }

  @keyframes topbar-cursor-blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar__cursor {
      animation: none;
      opacity: 1;
    }
  }

  .topbar__actions {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  .topbar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--r-2);
    color: var(--text-secondary);
    font-size: var(--fs-16);
    cursor: pointer;
  }

  .topbar__btn:hover,
  .topbar__btn:focus-visible {
    color: var(--fg);
    background: var(--surface-hover, var(--surface));
  }

  .topbar__swatch {
    width: 14px;
    height: 14px;
    border-radius: var(--r-pill);
    background: var(--accent);
  }

  /* ---------------------------------------------------------------------
   * Mobile nav sheet
   * ------------------------------------------------------------------- */
  .nav-sheet {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: var(--s-4);
    background: var(--bg);
    color: var(--fg);
    border: 0;
  }

  .nav-sheet::backdrop {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .nav-sheet:not([open]) {
    display: none;
  }

  .nav-sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--s-4);
  }

  .nav-sheet__search {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    margin-bottom: var(--s-2);
    padding: var(--s-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-2);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    text-align: left;
    cursor: pointer;
  }
</style>
