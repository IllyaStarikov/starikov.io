---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../site.config';
import { THEME_BOOT_SRC } from '../lib/theme-boot';
// Themes CSS is emitted as its own early <link> (below) rather than folded into
// Astro's bundled stylesheet, so it is guaranteed to appear in the head BEFORE
// the pre-paint boot script and before tokens/global -- the per-variant
// `[data-theme]` blocks define --bg/--fg/..., and global.css's
// `var(--token, fallback)` use-site fallbacks only fire if a bad id sneaks in.
import themesGeneratedHref from '../styles/themes.generated.css?url';
import '@fontsource/commit-mono/latin-400.css';
import '@fontsource/commit-mono/latin-700.css';
import '../styles/tokens.css';
import '../styles/global.css';
// Resolved, fingerprinted URLs for the two fonts that render text on every
// page -- preloaded below so the browser fetches them before it discovers
// them via CSS. Not the whole font set: Commit Mono 700 loads lazily, only
// on pages that actually render bold mono text.
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import commitMono400Woff2 from '@fontsource/commit-mono/files/commit-mono-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

// Absolute URLs for social/canonical meta. Astro.site is the config `site`
// (https://starikov.io); fall back to SITE.origin for safety.
const siteBase = Astro.site ?? new URL(SITE.origin);
const canonical = new URL(Astro.url.pathname, siteBase).toString();
const ogImage = new URL('/og-default.png', siteBase).toString();
const rssHref = new URL('/rss.xml', siteBase).toString();

const gaInlineScript = `
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '${SITE.gaId}', { send_page_view: false });
  document.addEventListener('astro:page-load', () => gtag('event', 'page_view', {
    page_location: location.href, page_title: document.title }));
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={rssHref} />
    <!-- Social cards: a static default OG image (design spec §7; per-page satori
         endpoint is v1.1). Title/description mirror the per-page tags above. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Per-variant theme tokens. First stylesheet in the head and render-
         blocking, so the palette the boot script selects is painted with no
         flash. Must precede the boot script (below). -->
    <link rel="stylesheet" href={themesGeneratedHref} />
    <!-- Sensible no-JS default (tokyonight-storm bg); the boot script below
         overwrites this pre-paint from the resolved theme. -->
    <meta name="theme-color" content="#24283b" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; frame-src https://academia.starikov.io; base-uri 'none'; object-src 'none'"
    />
    <!-- Font preloads come AFTER the CSP meta so the policy governs them (a
         meta-delivered CSP only applies to content that follows it in the head). -->
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={commitMono400Woff2} as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <slot name="head" />
    <!-- Pre-paint theme boot: resolves data-theme + theme-color before first
         paint, live-switches system mode, and re-applies on astro:after-swap.
         data-astro-rerun re-executes it after every ClientRouter navigation. -->
    <script is:inline data-astro-rerun set:html={THEME_BOOT_SRC} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}
    ></script>
    <script is:inline set:html={gaInlineScript} />
  </head>
  <body>
    <!-- First focusable element on every page: jump straight to the page main
         region (id="main", provided by Shell), bypassing the sidebar. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
