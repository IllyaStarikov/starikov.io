---
/*
 * ThemeControl -- the signature theme picker.
 *
 * Self-contained: renders its own trigger + popover and ships its own script
 * (src/scripts/theme-control.ts). Lives in the desktop sidebar's footer
 * (Sidebar.astro renders it there, below the nav groups) -- the host is
 * responsible for positioning, not this component. Below the ≥1024px sidebar
 * breakpoint the mobile nav sheet gets a lightweight mode-toggle button
 * instead, so exactly one ThemeControl (and one `#theme-popover` id) exists
 * in the document at a time; SystemCard's own theme row opens this SAME
 * popover rather than owning a second one (see SystemCard.astro's doc).
 *
 * Server-rendered from the generated theme manifest so the 8 family rows exist
 * in the HTML immediately (no island, no hydration). Each row carries both its
 * light and dark swatch as data-* so the client recolors rows live when the
 * mode flips. The trigger renders the default family; the client corrects it to
 * the visitor's stored theme on load.
 */
import themesData from '../data/generated/themes.json';
import { DEFAULTS } from '../lib/theme-boot';

const families = themesData.families;
const defaultFamily = DEFAULTS.family;

function swatchOf(family: (typeof families)[number], fullId: string) {
  return family.variants.find((v) => v.id === fullId)?.swatch;
}

const rows = families.map((family) => ({
  id: family.id,
  name: family.name,
  light: swatchOf(family, family.pair.light),
  dark: swatchOf(family, family.pair.dark),
}));

const defaultRow = rows.find((r) => r.id === defaultFamily) ?? rows[0];
const modes = [
  { id: 'light', label: 'Light' },
  { id: 'dark', label: 'Dark' },
  { id: 'system', label: 'System' },
] as const;
---

<div class="theme-control" data-theme-control data-default-family={defaultFamily}>
  <button
    type="button"
    class="theme-control__trigger"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="theme-popover"
    data-theme-trigger
  >
    <span class="sr-only">Theme:&nbsp;</span>
    <span
      class="theme-control__dot"
      data-theme-dot
      style={`background:${defaultRow.dark?.accent ?? 'var(--accent)'}`}
      aria-hidden="true"></span>
    <span class="theme-control__label" data-theme-label>{defaultRow.name}</span>
  </button>

  <div
    class="theme-control__popover"
    id="theme-popover"
    role="dialog"
    aria-label="Theme picker"
    data-theme-popover
    hidden
  >
    <p class="mono-label theme-control__heading" id="theme-popover-family">Family</p>
    <ul class="theme-control__families" role="group" aria-labelledby="theme-popover-family">
      {
        rows.map((row) => (
          <li>
            <button
              type="button"
              class="theme-control__family"
              data-family={row.id}
              data-swatch-light={JSON.stringify(row.light)}
              data-swatch-dark={JSON.stringify(row.dark)}
              style={`background:${row.dark?.bg ?? 'var(--surface)'};color:${row.dark?.fg ?? 'var(--fg)'}`}
              aria-pressed="false"
            >
              <span
                class="theme-control__family-dot"
                data-family-dot
                style={`background:${row.dark?.accent ?? 'var(--accent)'}`}
                aria-hidden="true"
              />
              <span class="theme-control__family-name" data-family-name>
                {row.name}
              </span>
            </button>
          </li>
        ))
      }
    </ul>

    <p class="mono-label theme-control__heading" id="theme-popover-mode">Mode</p>
    <div class="theme-control__modes" role="group" aria-labelledby="theme-popover-mode">
      {
        modes.map((mode) => (
          <button type="button" class="theme-control__mode" data-mode={mode.id} aria-pressed="false">
            {mode.label}
          </button>
        ))
      }
    </div>

    <!-- prettier-ignore -->
    <p class="theme-control__provenance">Generated from ~/.dotfiles/src/theme — the same colors.json that themes my terminal. <a href="/colophon">→ colophon</a></p>
  </div>
</div>

<script>
  import '../scripts/theme-control.ts';
</script>

<style>
  .theme-control {
    position: relative;
    display: inline-block;
    font-family: var(--font-mono);
  }

  /* .sr-only itself is the global utility (src/styles/global.css) -- no local
     redefinition here (v1.1 polish Task 5: one .sr-only, not three). */

  .theme-control__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-2);
    color: var(--fg);
    font-size: var(--fs-13);
    line-height: 1;
    cursor: pointer;
  }

  .theme-control__trigger:hover {
    background: var(--surface-hover, var(--surface));
  }

  .theme-control__dot,
  .theme-control__family-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--r-pill);
    flex: none;
  }

  /* JS-anchored (theme-control.ts sets left/bottom inline on open, and on
     every resize/scroll while open -- src/lib/popover-position.ts has the
     math + the full rationale). position:fixed escapes the sidebar's
     overflow-y:auto clip; nothing between this element and the viewport sets
     a transform/filter/perspective/contain that would create a fixed
     containing block ahead of the viewport itself. max-height + overflow-y is
     the fallback for a popover taller than the viewport has room for. */
  .theme-control__popover {
    position: fixed;
    z-index: 60;
    width: 260px;
    max-width: calc(100vw - 16px);
    max-height: calc(100dvh - 16px);
    overflow-y: auto;
    padding: var(--s-3);
    background: var(--surface-raised, var(--surface));
    border: 1px solid var(--border);
    border-radius: var(--r-3);
    /* The single sanctioned shadow in the system (design §4): floating layers. */
    box-shadow: var(--shadow-pop);
  }

  .theme-control__popover[hidden] {
    display: none;
  }

  .theme-control__heading {
    margin-bottom: var(--s-2);
  }

  .theme-control__heading:not(:first-child) {
    margin-top: var(--s-4);
  }

  .theme-control__families {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }

  .theme-control__family {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    padding: var(--s-2) var(--s-3);
    border: 1px solid transparent;
    border-radius: var(--r-2);
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }

  /* currentColor, not a fixed site color -- each row's background/color is a
     dynamic per-family swatch set inline by theme-control.ts, so only the
     row's own (contrast-designed) foreground is guaranteed to read against
     it. Declared before [aria-pressed='true'] so the active row's border
     still wins on hover/focus (equal specificity, source order breaks the tie
     -- matches .nav-link's is-active-over-hover convention). */
  .theme-control__family:hover,
  .theme-control__family:focus-visible {
    border-color: currentColor;
  }

  .theme-control__family[aria-pressed='true'] {
    border-color: currentColor;
    font-weight: 600;
  }

  .theme-control__family-name {
    flex: 1;
  }

  .theme-control__modes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-1);
    padding: 2px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-2);
  }

  .theme-control__mode {
    padding: var(--s-2);
    background: transparent;
    border: 0;
    border-radius: var(--r-1);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    cursor: pointer;
  }

  /* Declared before [aria-pressed='true'] so the active mode's own styling
     still wins on the tied specificity (see the family-row rule above). */
  .theme-control__mode:hover,
  .theme-control__mode:focus-visible {
    color: var(--fg);
    background: var(--surface-hover, var(--surface));
  }

  .theme-control__mode[aria-pressed='true'] {
    background: var(--surface-raised, var(--bg));
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .theme-control__provenance {
    margin-top: var(--s-3);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    line-height: 1.5;
  }

  .theme-control__provenance a {
    color: var(--accent);
    text-decoration-color: var(--accent);
    white-space: nowrap;
  }
</style>
