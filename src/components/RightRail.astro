---
/*
 * RightRail -- the ≥1280px companion column.
 *
 *   TOC: scrollspy list (IntersectionObserver in shell.ts). The active entry's
 *        colour flips instantly; a 2px marker slides between entries (180ms).
 *   Facts: a compact label/value list of page facts (e.g. a tool's language,
 *        dependency badge, license, updated date). Rendered when non-empty.
 *   Connections: rendered ONLY at ≥2 resolved links -- never an empty
 *        affordance (design spec §3). Enforced here, not by the caller.
 *
 * The whole rail is omitted when there is no TOC, no facts, and no valid
 * Connections block, so the grid can drop to two columns.
 */
interface TocItem {
  id: string;
  label: string;
}
interface Fact {
  label: string;
  value: string;
  href?: string;
  external?: boolean;
  /** Renders the value as an accent mono pill (e.g. `stdlib-only`). */
  badge?: boolean;
}
interface Connection {
  href: string;
  label: string;
  external?: boolean;
}
interface Props {
  toc?: TocItem[];
  facts?: Fact[];
  connections?: Connection[];
}
const { toc = [], facts = [], connections = [] } = Astro.props;
const showToc = toc.length > 0;
const showFacts = facts.length > 0;
const showConnections = connections.length >= 2;
---

{
  (showToc || showFacts || showConnections) && (
    <div class="rail">
      {showToc && (
        <nav class="toc" aria-label="On this page" data-toc>
          <p class="rail-label">On this page</p>
          <span class="toc__marker" aria-hidden="true" data-toc-marker />
          <ul>
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`} data-toc-link={item.id}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {showFacts && (
        <div class="facts">
          <p class="rail-label">Facts</p>
          <dl>
            {facts.map((f) => (
              <div class="facts__row">
                <dt>{f.label}</dt>
                <dd>
                  {f.href ? (
                    <a
                      href={f.href}
                      {...(f.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {f.value}
                      {f.external && <span aria-hidden="true"> ↗</span>}
                    </a>
                  ) : f.badge ? (
                    <span class="facts__badge">{f.value}</span>
                  ) : (
                    <span>{f.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {showConnections && (
        // data-pagefind-ignore: a curated cross-link list, not the page's own
        // content -- see Breadcrumbs.astro's note. The rail already renders
        // outside Shell's data-pagefind-body <main>, so this is belt-and-
        // suspenders, matching the other three excluded chrome blocks.
        <nav class="connections" aria-label="Connections" data-pagefind-ignore>
          <p class="rail-label">Connections</p>
          <ul>
            {connections.map((c) => (
              <li>
                <a
                  href={c.href}
                  {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {c.label}
                  {c.external && <span aria-hidden="true"> ↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  )
}

<style>
  .rail {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    max-height: 100vh; /* fallback: iOS Safari <15.4 has no dvh */
    max-height: 100dvh;
    padding: var(--s-6) var(--s-4);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    font-size: var(--fs-14);
  }

  .rail-label {
    margin-bottom: var(--s-3);
    font: 500 var(--fs-11) / 1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-secondary);
  }

  .toc,
  .connections {
    position: relative;
  }

  .toc ul,
  .connections ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* TOC hangs off a 1px baseline; the marker rides on top of it. */
  .toc ul {
    border-left: 1px solid var(--border);
  }

  .toc li a {
    display: block;
    padding: var(--s-1) var(--s-3);
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.4;
  }

  .toc li a:hover,
  .toc li a:focus-visible {
    color: var(--fg);
  }

  .toc li a.is-active {
    color: var(--fg);
  }

  .toc__marker {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 0;
    background: var(--accent);
    opacity: 0;
    /* transform-only slide; height is set once (uniform rows) so only
       translateY animates. reduced-motion path never adds the transition. */
  }

  .toc[data-spy='on'] .toc__marker {
    opacity: 1;
    /* 180ms per spec §4 motion table (no token at 180 — the FLIP value). */
    transition: transform 180ms var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc[data-spy='on'] .toc__marker {
      transition: none;
    }
  }

  /* -- Facts --------------------------------------------------------------- */
  .facts dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .facts__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .facts__row dt {
    font: 500 var(--fs-11) / 1.4 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .facts__row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    color: var(--fg);
    text-align: right;
  }

  .facts__row dd a {
    color: var(--fg);
    text-decoration: none;
  }

  .facts__row dd a:hover,
  .facts__row dd a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  /* stdlib-only style badge: accent mono chip, drawn from raw ANSI tokens. */
  .facts__badge {
    display: inline-block;
    padding: 2px 7px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: var(--fs-12);
    line-height: 1.4;
  }

  .connections li a {
    display: block;
    padding: var(--s-1) 0;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.5;
  }

  .connections li a:hover,
  .connections li a:focus-visible {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
</style>
