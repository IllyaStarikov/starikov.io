---
/*
 * ProvenanceFooter -- the honesty line at the foot of every project page: where
 * the auto metadata came from, and when the human overlay was last touched.
 * (The same authenticity-through-disclosure move as /colophon's palette
 * provenance and the dotfiles' validate-themes.sh.)
 *
 * Two build-time git reads, each guarded so a missing .git or uncommitted file
 * never fails the build (and, crucially, never fabricates a fact):
 *
 *   1. source sha -- for the ONE repo checked out locally (.sources/dotfiles),
 *      `git -C <dir> rev-parse --short HEAD` gives the palette/source commit,
 *      printed as "Auto-generated from <repo>@<sha>". This is read ONLY when
 *      <dir> is its OWN git checkout: CI's actions/checkout populates
 *      .sources/dotfiles WITH a .git, so the true source commit is available; a
 *      local sync-sources.sh copy is an rsync WITHOUT .git, and an unguarded
 *      `git -C <dir> rev-parse` would then WALK UP into THIS site's repo and
 *      return the SITE's HEAD -- mislabeling it as the dotfiles source sha (a
 *      false provenance line on the flagship page). Guarding on a real .git makes
 *      a local build honestly render "<repo>@snapshot" instead (mirroring
 *      /colophon and build-themes.mjs's identical guard). Every other project has
 *      no local checkout, so it falls back to "Metadata via GitHub API · <date>".
 *   2. overlay edit date -- `git log -1 --format=%as -- <overlay>` dates the
 *      curated MDX; falls back to the file's mtime for an as-yet-uncommitted
 *      overlay.
 *
 * Both reads use execFileSync's array form (no shell, no string interpolation of
 * paths) so a directory or overlay path is never re-parsed by a shell.
 */
import { execFileSync } from 'node:child_process';
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** Primary repo "owner/name" the page is generated from. */
  repo?: string;
  /** Local checkout dir whose HEAD sha to read (only .sources/dotfiles exists). */
  sourceDir?: string;
  /** Overlay path relative to the repo root, e.g. src/content/projects/x.mdx. */
  overlayPath: string;
}
const { repo, sourceDir, overlayPath } = Astro.props;

function git(args: string[]): string | null {
  try {
    return execFileSync('git', args, {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return null;
  }
}

function shortSha(dir: string): string | null {
  // Only read a sha when `dir` is its OWN git checkout (see the guard rationale
  // in the module header) -- otherwise the walk-up would report THIS repo's HEAD.
  if (!existsSync(join(dir, '.git'))) return null;
  return git(['-C', dir, 'rev-parse', '--short', 'HEAD']) || null;
}

function overlayEdited(path: string): string | null {
  const logged = git(['log', '-1', '--format=%as', '--', path]);
  if (logged) return logged;
  try {
    return statSync(path).mtime.toISOString().slice(0, 10);
  } catch {
    return null;
  }
}

const buildDate = new Date().toISOString().slice(0, 10);
const sha = sourceDir ? shortSha(sourceDir) : null;
const edited = overlayEdited(overlayPath);

// A locally-synced source dir has no .git, so `sha` is null even though the page
// IS generated from that source -- render "<repo>@snapshot" (matching /colophon)
// rather than falsely attributing GitHub-API provenance to a palette-sourced page.
const sourceLine =
  repo && sha
    ? `Auto-generated from ${repo}@${sha}`
    : repo && sourceDir
      ? `Auto-generated from ${repo}@snapshot`
      : repo
        ? `Metadata via GitHub API · ${buildDate}`
        : null;
---

<!-- data-pagefind-ignore: build provenance, not page content ("Auto-generated
     from owner/repo@sha" would otherwise be indexed verbatim on every project
     page and swamp genuine matches on repo names/shas). -->
<footer class="provenance" data-pagefind-ignore>
  {sourceLine && <span>{sourceLine}</span>}
  {
    edited && (
      <>
        {sourceLine && (
          <span class="provenance__dot" aria-hidden="true">
            ·
          </span>
        )}
        <span>Overlay last edited {edited}</span>
      </>
    )
  }
</footer>

<style>
  .provenance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-8);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-12);
    color: var(--text-secondary);
  }

  .provenance__dot {
    user-select: none;
  }
</style>
