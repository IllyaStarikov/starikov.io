---
/*
 * RelatedEssays -- the "Related essays" tail of a project page. Renders NOTHING
 * while the list is empty (design spec §3: never an empty affordance). The list
 * comes from `resolveRelatedEssays` (src/lib/related.ts): manual `essays:` slugs
 * first, then `essayTags` matching, else absent -- so a project with neither
 * simply omits the section.
 *
 * Rows link OUT to starikov.co (essays are read there, design spec §13), so each
 * is external with a `↗`.
 */
import type { Essay } from '../lib/related';

interface Props {
  essays: Essay[];
}
const { essays } = Astro.props;
---

{
  essays.length > 0 && (
    <!-- data-pagefind-ignore: an auto-generated cross-link tail, not the
         project's own content -- search should surface the project page once,
         for its own words, not once per related-essay title it happens to link. -->
    <section class="related" aria-labelledby="related-essays" data-pagefind-ignore>
      <h2 id="related-essays" class="related__label">
        Related essays
      </h2>
      <ul class="related__list">
        {essays.map((essay) => (
          <li>
            <a class="related__row" href={essay.url} target="_blank" rel="noopener noreferrer">
              <span class="related__title">
                {essay.title}
                <span class="related__ext" aria-hidden="true">
                  {' '}
                  ↗
                </span>
              </span>
              {essay.excerpt && <span class="related__excerpt">{essay.excerpt}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    margin-top: var(--s-8);
  }

  .related__label {
    margin-bottom: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--border);
    font: 500 var(--fs-13) / 1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-secondary);
  }

  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related__row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .related__title {
    font-weight: 600;
    font-size: var(--fs-16);
    line-height: 1.3;
  }

  .related__row:hover .related__title,
  .related__row:focus-visible .related__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.15em;
  }

  .related__ext {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .related__excerpt {
    color: var(--text-secondary);
    font-size: var(--fs-14);
    line-height: 1.45;
  }
</style>
