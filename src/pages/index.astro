---
/*
 * Home (`~`) -- the first five seconds of the site (design spec §3, §5).
 *
 * Hero: a mono `whoami` prompt, a mono identity line, the statement (fluid
 * --fs-statement, 30px→44px) it answers, a two-line dek, and two mono links
 * (`browse the index →`, `press ⌘K` on hover-capable pointers / `search →` on
 * touch -- pure CSS swap, see .hero__link--kbd/--touch below). Beside it, the
 * live SystemCard -- a neofetch panel whose `theme:` row is the theme picker
 * itself.
 *
 * Below the fold, three ledgers:
 *   - Start here      the four front doors (dotfiles, eclecta, mcp, academia)
 *                      (SiteItem model)
 *   - Recently updated the five newest DATED, non-essay items across every
 *                      collection, excluding anything already curated in
 *                      Start here above (SiteItem model; see src/lib/recent.ts
 *                      for the pure selection rule); guarded absent if that
 *                      ever leaves zero rows
 *   - Latest essays    the 3 most recent Ghost posts, queried directly (not
 *                      via SiteItem) for the tag-dot accent; guarded absent
 *                      if the essays collection ever loads zero
 *
 * First-visit only, the ledger rows rise in a short stagger (CSS animation,
 * sessionStorage-guarded, reduced-motion disabled globally). No headshot, no
 * "Hi, I'm", no bento -- a statement and a system.
 */
import Shell from '../layouts/Shell.astro';
import SystemCard from '../components/SystemCard.astro';
import LedgerRow from '../components/LedgerRow.astro';
import Kbd from '../components/Kbd.astro';
import { getCollection } from 'astro:content';
import { getAllItems, joinRepos, summarizeRepos, selectRecentItems } from '../lib/model';
import { formatRelativeTime } from '../lib/relative-time';
import { firstTagAccent } from '../lib/essays';

// Editorial rule (v1.1 polish, Task 3): the statement is ONE sentence, ≤90
// chars, and must render in ≤4 lines at the 24ch measure `.hero__statement`
// gives it -- a punchy answer to `whoami`, not a paragraph. Name + role
// already live in the mono id line above it, so this doesn't repeat them.
const STATEMENT =
  'The workshop: ten years of dotfiles, tools, and essays — documented like it matters.';

// ★stars · language · updated (relative) -- any unavailable fact is dropped.
const repos = await getCollection('repos');
function repoMeta(names: string[]): string[] {
  const summary = summarizeRepos(joinRepos(names, repos));
  const rel = summary.updated ? formatRelativeTime(summary.updated) : null;
  return [
    summary.stars !== null ? `★ ${summary.stars}` : null,
    summary.language,
    rel ? `updated ${rel}` : null,
  ].filter((x): x is string => Boolean(x));
}

// -- Start here: the four front doors, deks pulled from their own entries -----
const projects = await getCollection('projects');
const projectBySlug = new Map(projects.map((p) => [p.id, p]));
function projectRepoNames(slug: string): string[] {
  const p = projectBySlug.get(slug);
  if (!p) return [];
  return [...(p.data.repo ? [p.data.repo] : []), ...p.data.repos];
}

const startHere = [
  { slug: 'dotfiles', href: '/projects/dotfiles', names: projectRepoNames('dotfiles') },
  { slug: 'eclecta', href: '/projects/eclecta', names: projectRepoNames('eclecta') },
  { slug: 'mcp-servers', href: '/projects/mcp-servers', names: projectRepoNames('mcp-servers') },
].map((d) => ({
  href: d.href,
  title: projectBySlug.get(d.slug)?.data.title ?? d.slug,
  dek: projectBySlug.get(d.slug)?.data.tagline,
  meta: repoMeta(d.names),
}));
startHere.push({
  href: '/academia',
  title: 'Academia',
  dek: 'Four bound LaTeX volumes and a media showcase from the Missouri S&T years.',
  meta: repoMeta(['IllyaStarikov/academia']),
});

// -- Recently updated: newest non-essay items not already curated above ------
// (design spec §3): essays own LATEST ESSAYS below and curated START HERE rows
// already show their own `updated` meta, so both are unconditionally excluded
// here rather than merely deduplicated against a longer list. Pure selection
// logic lives in src/lib/recent.ts (selectRecentItems) so it's unit-tested
// (test/recent.test.ts) independent of this page's Astro glue.
const allItems = await getAllItems();
// No 'page' entry: selectRecentItems (src/lib/recent.ts) filters on
// `Boolean(item.date)`, and PAGE_ITEMS is deliberately undated by
// construction (src/lib/page-items.ts) -- a 'page'-typed row can never
// survive into `recent` below, so a label for it here is unreachable dead
// code (same reasoning as changelog.astro's identical TYPE_LABEL).
const TYPE_LABEL: Record<string, string> = {
  tool: 'tool',
  project: 'project',
};
// Built AFTER startHere's `.push()` above, so /academia (added there, not in
// the initial three-project array) is included in the exclusion set too.
const startHereHrefs = new Set(startHere.map((row) => row.href));
const recent = selectRecentItems(allItems, startHereHrefs).map((item) => {
  const rel = item.date ? formatRelativeTime(item.date) : null;
  return {
    href: item.href,
    title: item.title,
    dek: item.tagline,
    meta: [TYPE_LABEL[item.type] ?? item.type, rel ? `updated ${rel}` : null].filter(
      (x): x is string => Boolean(x),
    ),
  };
});

// -- Latest essays: the 3 most recent Ghost posts, tag dot + relative date --
// (design spec §3). Queried directly (not via allItems/SiteItem) because the
// row needs the tag dot's accent, which the uniform SiteItem shape doesn't
// carry. Guarded absent (design spec §3: right rail's Connections rule
// applies here too -- no empty affordance) if the essays collection ever
// loads zero (every fallback tier failed).
const essayEntries = await getCollection('essays');
const essayTagMap = new Map(
  (await getCollection('essayTags')).map((t) => [t.id, { name: t.data.name, accentColor: t.data.accentColor }]),
);
const latestEssays = [...essayEntries]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3)
  .map((entry) => {
    const dot = firstTagAccent(entry.data.tags, essayTagMap);
    const rel = formatRelativeTime(entry.data.publishedAt);
    return {
      href: entry.data.url,
      title: entry.data.title,
      dek: entry.data.excerpt,
      tag: dot ? { label: dot.name, accent: dot.accent } : undefined,
      meta: rel ? [rel] : [],
    };
  });

// Global row index so the entrance stagger runs across both ledgers. The motion
// table caps the cascade at the first 10 rows (indices 0-9); the 11th row onward
// gets no --row-i and a data-no-stagger flag, so the CSS animation is not applied
// and the row paints instantly (never a delayed-but-still-animating tail row).
let rowIndex = 0;
const STAGGER_ROWS = 10;
const nextRow = () => rowIndex++;
---

<Shell
  title="starikov.io — Illya Starikov"
  description="Illya Starikov — software engineer. The workshop: ten years of dotfiles, command-line tools, coursework, and essays, pulled from live sources and themed by the same colors.json as my terminal."
  pageType="home"
>
  <div class="home">
    <section class="hero" aria-label="Introduction">
      <div class="hero__lede">
        <p class="hero__prompt"><span class="hero__caret" aria-hidden="true">~ ❯</span> whoami</p>
        <p class="hero__id">Illya Starikov — software engineer</p>
        <h1 class="text-statement hero__statement">{STATEMENT}</h1>
        <p class="hero__dek">
          Everything I've built, kept like a wiki and wired to grow on its own — pulled from live
          repositories and the dotfiles theme engine at every build.
        </p>
        <div class="hero__links">
          <a class="hero__link" href="/projects">browse the index →</a>
          {/* Touch affordance: both buttons share the exact data-open-palette
              mechanism shell.ts already wires (querySelectorAll over every
              match -- no JS branching needed). @media (hover: none) below is
              the only thing that decides which one is shown: a keyboard
              shortcut is a lie on a touchscreen, so touch gets a plain
              "search →" button instead of the ⌘K glyph. */}
          <button class="hero__link hero__link--btn hero__link--kbd" type="button" data-open-palette>
            press <Kbd label="Command K">⌘K</Kbd>
          </button>
          <button class="hero__link hero__link--btn hero__link--touch" type="button" data-open-palette>
            search →
          </button>
        </div>
      </div>

      <SystemCard />
    </section>

    <section class="home-section" aria-labelledby="start-here-label">
      <div class="section-head">
        <h2 class="section-head__label" id="start-here-label">start here</h2>
        <span class="section-head__rule" aria-hidden="true"></span>
      </div>
      <div class="ledger" data-entrance>
        {
          startHere.map((row) => {
            const i = nextRow();
            const staggered = i < STAGGER_ROWS;
            return (
              <div
                class="ledger__item"
                style={staggered ? `--row-i:${i}` : undefined}
                data-no-stagger={staggered ? undefined : ''}
              >
                <LedgerRow href={row.href} title={row.title} dek={row.dek} meta={row.meta} />
              </div>
            );
          })
        }
      </div>
    </section>

    {
      recent.length > 0 && (
        <section class="home-section" aria-labelledby="recent-label">
          <div class="section-head">
            <h2 class="section-head__label" id="recent-label">recently updated</h2>
            <span class="section-head__rule" aria-hidden="true"></span>
          </div>
          <div class="ledger" data-entrance>
            {
              recent.map((row) => {
                const i = nextRow();
                const staggered = i < STAGGER_ROWS;
                return (
                  <div
                    class="ledger__item"
                    style={staggered ? `--row-i:${i}` : undefined}
                    data-no-stagger={staggered ? undefined : ''}
                  >
                    <LedgerRow href={row.href} title={row.title} dek={row.dek} meta={row.meta} />
                  </div>
                );
              })
            }
          </div>
        </section>
      )
    }

    {
      latestEssays.length > 0 && (
        <section class="home-section" aria-labelledby="essays-label">
          <div class="section-head">
            <h2 class="section-head__label" id="essays-label">
              latest essays
            </h2>
            <span class="section-head__rule" aria-hidden="true" />
          </div>
          <div class="ledger">
            {latestEssays.map((item) => (
              <div class="ledger__item">
                <LedgerRow
                  href={item.href}
                  title={item.title}
                  dek={item.dek}
                  meta={item.meta}
                  tag={item.tag}
                  external
                />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>

  {/* First-visit stagger: enable the CSS animation only once per session and
      never under reduced motion. Inline + synchronous so it runs before the
      rows first paint (no flash of static-then-animated). */}
  <script
    is:inline
    set:html={`(function(){try{if(sessionStorage.getItem('home-entrance-done'))return;sessionStorage.setItem('home-entrance-done','1');}catch(e){}if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)return;document.querySelectorAll('[data-entrance]').forEach(function(el){el.classList.add('is-entering');});})();`}
  />
</Shell>

<style>
  .home {
    max-width: 68rem;
  }

  /* ---------------------------------------------------------------------
   * Hero: statement beside the system card
   *
   * Breakpoint is a CONTAINER query bound to `.content-col`'s inline-size
   * (Shell.astro: `container: content / inline-size`), not the viewport --
   * the old `@media (min-width: 900px)` didn't know the sidebar exists, so it
   * forced two columns into a squeeze once the ≥1024px sidebar ate 240px.
   * `@container content (min-width: 720px)` reacts to the space .content-col
   * actually has, so it correctly drops to one column in that squeeze zone
   * and returns to two once the container regains room. No-container-query
   * browsers never match `@container` at all, so they get the base (single
   * column) rule -- an acceptable, honest degrade.
   * ------------------------------------------------------------------- */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
    /* Small-viewport padding trimmed (was --s-6/--s-8) so the SystemCard's
       top edge enters the first 390×844 viewport instead of sitting just
       past its bottom edge. */
    padding: var(--s-5) 0 var(--s-7);
  }

  @container content (min-width: 720px) {
    .hero {
      grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
      gap: var(--s-8);
      align-items: start;
      padding: var(--s-8) 0 var(--s-9);
    }
  }

  .hero__prompt {
    font-family: var(--font-mono);
    font-size: var(--fs-13);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .hero__caret {
    color: var(--accent);
  }

  .hero__id {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--text-secondary);
  }

  .hero__statement {
    margin-top: var(--s-4);
    max-width: 24ch;
    text-wrap: balance;
  }

  .hero__dek {
    margin-top: var(--s-5);
    max-width: 52ch;
    color: var(--text-secondary);
    font-size: var(--fs-16);
    line-height: var(--lh-body);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-5);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-2) var(--ease-out);
  }

  .hero__link:hover,
  .hero__link:focus-visible {
    text-decoration-color: var(--accent);
  }

  .hero__link--btn {
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* Touch affordance: default (hover-capable pointer) shows the ⌘K button;
     a touchscreen can't press a keyboard shortcut, so `(hover: none)` swaps
     to a plain "search →" button instead. Both buttons carry the identical
     data-open-palette attribute, so shell.ts's existing wireSearch() wires
     both without any JS branching -- this swap is pure CSS. */
  .hero__link--touch {
    display: none;
  }

  @media (hover: none) {
    .hero__link--kbd {
      display: none;
    }

    .hero__link--touch {
      display: inline-flex;
    }
  }

  /* ---------------------------------------------------------------------
   * Below-fold ledgers
   * ------------------------------------------------------------------- */
  .home-section {
    margin-top: var(--s-7);
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin-bottom: var(--s-2);
  }

  .section-head__label {
    font: 500 var(--fs-13) / 1 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-secondary);
  }

  .section-head__rule {
    flex: 1;
    border-top: 1px solid var(--border);
  }

  .ledger {
    display: flex;
    flex-direction: column;
  }

  /* First-visit entrance: 240ms rise, 20ms per-row stagger, first 10 rows only.
     Rows past the 10th carry data-no-stagger and are excluded, so they paint
     instantly rather than fading in on a growing delay. Only plays when the guard
     script adds .is-entering (never under reduced motion, never on repeat
     visits). global.css disables it for reduced motion. */
  [data-entrance].is-entering .ledger__item:not([data-no-stagger]) {
    animation: home-row-in 240ms var(--ease-out) both;
    animation-delay: calc(var(--row-i, 0) * 20ms);
  }

  @keyframes home-row-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
